<!--pages/my/my.wxml-->

<!-- 顶部用户信息 -->
<view class="user-info">
  <image class="avatar" src="{{userInfo.avatarUrl ||'https://mmbiz.qpic.cn/mmbiz/icTdbqWNOwNRna42FI242Lcia07jQodd2FJGIYQfG0LAJGFxM4FbnQP6yfMxBgJ0F3YRqJCJ1aPAK2dQagdusBZg/0'}}" bindtap="login" mode="aspectFill" />
  <text class="nickname" bindtap="login">{{userInfo.nickname || '点击登录'}}</text>
  <text class="userGroup" wx:if="{{isLoggedIn&&userInfo.groupType}}" >{{userInfo.groupType || ''}}</text>
</view>

<!-- 功能列表 -->
<view class="menu-list">
  <view class="menu-item" bindtap="goToUserProfile" data-url="/pages/proflie/profile">
    <text>个人信息</text>
    <!--<image class="arrow" src="/assets/icon-arrow-right.png" />-->
  </view>
  <view class="menu-item" bindtap="goToSettings" data-url="/pages/settings/settings">
    <text>设置</text>
    <!--<image class="arrow" src="/assets/icon-arrow-right.png" />-->
  </view>
</view>

<!-- 退出登录按钮（可选） -->
<button wx:if="{{isLoggedIn}}" class="logout-btn" bindtap="logout">退出登录</button>

<view class="footer">
  <text>
  噪声累积能量监测 小程序<br />
  {{version}}<br /> 
  内部评估版本
  </text>
  <text wx:if="{{isLoggedIn}}"> <br />UID: {{userInfo.userId}}</text>
</view>