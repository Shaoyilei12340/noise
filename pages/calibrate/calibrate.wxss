.container {
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.title {
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 20px;
}
.noise-level {
  font-size: 18px;
  margin-bottom: 20px;
}
.increase-btn {
  margin-bottom: 20px;
}
.nav-buttons {
  display: flex;
  justify-content: space-around;
  width: 100%;
}
.nav-buttons button {
  width: 45%;
}
page {
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

.page {
  padding: 40rpx;
}

.head {
  text-align: center;
  margin-bottom: 60rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.sub {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #666;
}

.section {
  margin-bottom: 60rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.05);
}
.section--advanced {
  margin-bottom: 60rpx;
  background: #4facfe5d;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.05);
}
.pic {
  width: 100%;
  height: 260rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.h2 {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.p {
  font-size: 30rpx;
  line-height: 1.7;
  color: #555;
  white-space: pre-line;
}
.btn {
  margin: 20rpx 30rpx;
  padding: 20rpx;
  font-size: 30rpx;
  border-radius: 16rpx;
}
.btn--primary {
  background: linear-gradient(to right, #4facfe, #00f2fe);
  color: white;
}
.btn--ghost {
  background: transparent;
  color: #4facfe;
  border: 2rpx solid #4facfe;
}
.btn--plain {
  background: #f5f5f5;
  color: #333;
}

.footer {
  display: flex;
  gap: 20rpx;
  justify-content: space-around;
  flex-wrap: wrap;
}

.canvas-container{
  position: relative;
}
.canvas-container canvas{
  position: absolute;
  left: 0;
  top: 0;
}

#canvas-back{
  z-index: -1;
}
#canvas-front {
  z-index: 1;
}