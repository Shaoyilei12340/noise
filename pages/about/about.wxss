/* pages/knowledge/about.wxss */
page {
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

.page {
  padding: 40rpx;
}

.head {
  text-align: center;
  margin-bottom: 60rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.sub {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #666;
}

.section {
  margin-bottom: 60rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.05);
}
.pic {
  width: 100%;
  height: 260rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.h2 {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.p {
  font-size: 30rpx;
  line-height: 1.7;
  color: #555;
  white-space: pre-line;
}