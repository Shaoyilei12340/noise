page {
  background-color: #F4F5F7;
  min-height: 100vh;
  font-family: -apple-system, sans-serif;
}

/* 去掉蓝色的渐变导航背景，改为原生大标题风格 */
.nav {
  padding: 60rpx 32rpx 20rpx;
  background: transparent;
  box-shadow: none;
}
.nav__title {
  font-size: 56rpx;
  font-weight: 800;
  color: #111111;
  letter-spacing: 2rpx;
}

.content {
  padding: 0 0 60rpx 0;
}

/* 列表容器 */
.group {
  margin: 20rpx 32rpx 50rpx;
  background-color: transparent;
  box-shadow: none;
  padding: 0;
}

/* 分组标题 */
.group__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #888888;
  padding: 0 0 16rpx 16rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}
.group__subtitle {
  font-size: 24rpx;
  color: #AAAAAA;
  padding: 16rpx 0 0 16rpx;
}

/* 为了实现 iOS 那种全包裹的白色卡片，这里假设你在 wxml 里给 cell 外面套了一个包裹层。
   如果没有套，直接作用在组上也可以，这里用直接相邻选择器给 Cell 加白底 */
.cell {
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

/* 第一项顶部圆角，最后一项底部圆角，实现卡片包裹效果 */
.cell:first-of-type {
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
}
.cell:last-of-type {
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  border-bottom: none;
}

.cell__label {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
}
.cell__right {
  display: flex;
  align-items: center;
}

/* 步进器美化：更现代的无边框圆角按钮 */
.stepper__btn {
  width: 64rpx;
  height: 64rpx;
  background: #F4F5F7;
  border-radius: 50%;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  line-height: 60rpx;
  color: #A41F35; /* 华师大红强调色 */
  border: none;
  transition: all 0.2s;
}
.stepper__btn:active {
  background: #EAEAEA;
}
.stepper__btn--disabled {
  background: #F9F9F9;
  color: #CCCCCC;
}

.stepper__value {
  width: 110rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
  font-variant-numeric: tabular-nums;
}

.slider {
  flex: 1;
  margin: 0 30rpx;
}
.slider__value {
  font-size: 30rpx;
  font-weight: 600;
  color: #A41F35;
  min-width: 60rpx;
  text-align: right;
}

.picker {
  padding: 12rpx 24rpx;
  background: #F4F5F7;
  color: #333;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 按钮区美化：高级悬浮质感 */
.footer {
  padding: 20rpx 40rpx;
  display: flex;
  flex-direction: column; /* 竖向排列更符合移动端习惯 */
  gap: 30rpx;
}

.btn {
  width: 100% !important; /* 强制填满容器 */
  padding: 26rpx 0;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 100rpx; /* 大胶囊按钮 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn--primary {
  background: #A41F35; /* 华师大红 */
  color: #FFFFFF;
  box-shadow: 0 10rpx 20rpx rgba(164, 31, 53, 0.25); /* 红色按钮的同色系弥散发光 */
}

.btn--ghost {
  background: transparent;
  color: #A41F35;
  border: 2rpx solid #A41F35;
}

.btn--plain {
  /* “清除本地缓存”等次要操作按钮 */
  background: transparent;
  color: #888888;
  font-size: 28rpx;
  padding: 20rpx 0;
}