.page {
  background-color: #f5f7fa;
  min-height: 100vh;
}

.nav {
  background: linear-gradient(to right, #4facfe, #00f2fe);
  padding: 40rpx 30rpx 20rpx;
  color: white;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}
.nav__title {
  font-size: 36rpx;
  font-weight: bold;
}

.content {
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.group {
  width: 100%;
  background-color: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.group__title {
  font-size: 28rpx;
  font-weight: bold;
  padding: 20rpx 30rpx 10rpx;
}
.group__subtitle {
  font-size: 28rpx;
  font-weight:lighter;
  padding: 20rpx 30rpx 10rpx;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}
.cell:first-child {
  border-top: none;
}

.cell__label {
  font-size: 28rpx;
  color: #555;
  flex-shrink: 0;
}
.cell__right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.stepper__btn {
  width: 48rpx;
  height: 48rpx;
  background: #e0e0e0;
  font-size: 28rpx;
  border-radius: 50%;  /* 圆形按钮 */
  text-align: center;
  line-height: 48rpx;
  color: #333;
  border: 1rpx solid #ccc;
}
.stepper__btn--disabled {
  background: #f0f0f0;
  color: #aaa;
  border: 1rpx solid #ddd;
}

.stepper__value {
  width: 100rpx;
  text-align: center;
  font-size: 28rpx;
}

.slider {
  width: 300rpx;
}
.slider__value {
  font-size: 26rpx;
  color: #999;
  margin-left: 20rpx;
}

.picker {
  padding: 12rpx 20rpx;
  border: 1rpx solid #ccc;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.btn {
  margin: 20rpx 30rpx;
  padding: 20rpx;
  font-size: 30rpx;
  border-radius: 16rpx;
}
.btn--primary {
  background: linear-gradient(to right, #4facfe, #00f2fe);
  color: white;
}
.btn--ghost {
  background: transparent;
  color: #4facfe;
  border: 2rpx solid #4facfe;
}
.btn--plain {
  background: #f5f5f5;
  color: #333;
}

.footer {
  display: flex;
  gap: 20rpx;
  justify-content: space-around;
  flex-wrap: wrap;
}




