/* pages/pilot/pilot.wxss */
page {
  background: #f5f7fa;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.page {
  padding: 40rpx;
}

.hero {
  width: 720rpx;
  height: 360rpx;
  margin: 0 auto 40rpx;
  display: block;
}

.grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.card {
  display: flex;
  align-items: center;
  padding: 36rpx 40rpx;
  margin-bottom: 50px;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card--pressed {
  background: #4facfe !important;   /* 按下的瞬间变纯蓝 */
  /* 不加 transform / scale / opacity，图标文字就不会动 */
}

.card__icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.card__body {
  flex: 1;
}

.card__title {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.card__desc {
  font-size: 26rpx;
  opacity: 0.7;
  margin-top: 8rpx;
  display: block;
}

.card__arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.5;
}

.tip {
  margin-top: 60rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.e {
  margin-top: 150px;
}
