<view class="page-container">
  <!-- 1. 顶部状态与仪表盘（整块变色区） -->
  <view class="card dashboard {{threatClass}}">
    <view class="recording-tag">
      <view class="dot"></view>
      <text class="tag-text">噪声监测已启动</text>
    </view>
    
    <view class="main-value">
      <text class="db-num">{{dbspl}}</text>
      <text class="db-unit">dB SPL</text>
    </view>

    <view class="status-pill">
      <text class="status-text">{{threat}}</text>
    </view>
  </view>

  <!-- 2. 辅助数据两列 -->
  <view class="stats-row">
    <view class="card stats-card">
      <text class="stats-label">累积能量 (CNE)</text>
      <view class="stats-value">
        <text class="val">{{cne}}</text>
        <text class="unit">dB(A)</text>
      </view>
    </view>
    <view class="card stats-card">
      <text class="stats-label">数字电平 (dBFS)</text>
      <view class="stats-value">
        <text class="val">{{dbfs}}</text>
        <text class="unit">FS</text>
      </view>
    </view>
  </view>

  <!-- 3. 波形图表卡片（Canvas 居中） -->
  <view class="card chart-card">
    <view class="chart-header">
      <text class="chart-title">实时分贝声压级波形 [Z计权]</text>
    </view>
    <view class="canvas-container">
      <canvas id="canvas-front" type="2d" class="canvas-layer" />
    </view>
  </view>

  <!-- 4. 底部固定操作栏（按钮比例调整） -->
  <view class="action-bar">
  <!-- 缩小为正方形图标按钮 -->
  <view class="btn-mini" bindtap="recordMyLocation" hover-class="btn-hover-mini">
    <image src="/images/locate.svg" mode="aspectFit" class="mini-icon" />
  </view>

  <!-- 占据主要空间的两个平分按钮 -->
  <button class="btn-main btn-save" bindtap="_saveResult">保存记录</button>
  <button class="btn-main btn-stop" bindtap="stopNoiseMonitoring">停止</button>
  </view>
</view>