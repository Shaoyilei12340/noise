<!-- pages/index/index.wxml -->
<view class="page">
  <!-- 顶部氛围图 -->
  <image class="hero" src="/images/Doctors-pana.svg" mode="aspectFit" />
  <view class="grid">
    <!-- ① 开始检测 -->
    <view class="card" hover-class="card--pressed" bindtap="goToPilot">
      <image class="card__icon" src="/images/mic.svg" />
      <view class="card__body">
        <text class="card__title">检测前准备</text>
        <text class="card__desc">先校准 · 再检测</text>
      </view>
    </view>
    
    <!-- ② 麦克风校准 
    <view class="card" hover-class="card--pressed" bindtap="goToCalibrate">
      <image class="card__icon" src="/images/calibrate.svg" />
      <view class="card__body">
        <text class="card__title">麦克风校准</text>
        <text class="card__desc">声压级校正 · 偏移量测定</text>
      </view>
    </view>
    -->

    <!-- ③ 查询记录 -->
    <view class="card" hover-class="card--pressed" bindtap="goToResult">
      <image class="card__icon" src="/images/chart.svg" />
      <view class="card__body">
        <text class="card__title">查询记录</text>
        <text class="card__desc">历史结果 · 趋势分析</text>
      </view>
    </view>

    <!-- ④ 噪声危害科普 -->
    <view class="card" hover-class="card--pressed" bindtap="goToKnowledge">
      <image class="card__icon" src="/images/book.svg" />
      <view class="card__body">
        <text class="card__title">噪声危害科普</text>
        <text class="card__desc">标准限值 · 防护技巧</text>
      </view>
    </view>

    <!-- ⑤ 关于本项目 -->
    <view class="card" hover-class="card--pressed" bindtap="goToAbout">
      <image class="card__icon" src="/images/info.svg" />
      <view class="card__body">
        <text class="card__title">关于本项目</text>
        <text class="card__desc">项目说明</text>
      </view>
    </view>

  </view>

  <!-- 底部小贴士 -->
  <view class="tip">
    <text>长时间暴露于 85 dB SPL 以上环境可能损伤听力</text>
  </view>
</view>

