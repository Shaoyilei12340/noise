

// 噪声参数配置
const config = {
  sampleRate: 16000,    // 采样率（Hz）
  frameSize: 1024,      // 每帧采样点数
  threshold: 0.05,      // 噪声判断阈值（归一化能量）
  duration: 10,         // 最大持续时长（秒）
  minContinuous: 3      // 最小连续超标帧数
};

// 噪声状态变量
let noiseState = {
  isNoisy: false,
  continuousCount: 0,
  startTime: 0,
  energyHistory: []
};

// 开始噪声监测
function startNoiseMonitoring() {
  resetNoiseState();
  
  recorderManager.start({
    format: 'PCM',        // 原始PCM格式
    sampleRate: config.sampleRate,
    numberOfChannels: 1,  // 单声道
    frameSize: config.frameSize
  });
}

// 帧数据处理回调
recorderManager.onFrameRecorded(frame => {
  const pcmData = frame.frameBuffer;  // 获取PCM数据
  const energy = calculateEnergy(pcmData);
  
  // 更新能量历史记录（保留最近10秒）
  noiseState.energyHistory.push(energy);
  if (noiseState.energyHistory.length > config.duration * config.sampleRate / config.frameSize) {
    noiseState.energyHistory.shift();
  }
  
  // 噪声判断逻辑
  if (energy > config.threshold) {
    handleNoiseEvent(energy);
  } else {
    noiseState.continuousCount = 0;
    noiseState.isNoisy = false;
  }
});

// 计算音频帧能量（归一化）
function calculateEnergy(pcmData) {
  let sumSquares = 0;
  const int16Array = new Int16Array(pcmData);
  
  for (let i = 0; i < int16Array.length; i++) {
    // PCM值归一化到[-1, 1]
    const sample = int16Array[i] / 32768.0;
    sumSquares += sample * sample;
  }
  
  return Math.sqrt(sumSquares / int16Array.length); // RMS值
}

// 处理噪声事件
function handleNoiseEvent(energy) {
  noiseState.continuousCount++;
  
  // 首次检测到噪声
  if (!noiseState.isNoisy) {
    if (noiseState.continuousCount >= config.minContinuous) {
      noiseState.isNoisy = true;
      noiseState.startTime = Date.now();
      wx.showToast({ title: '检测到持续噪声！', icon: 'none' });
      
    }
  } 
  // 持续噪声处理
  else {
    const duration = (Date.now() - noiseState.startTime) / 1000;
    
    // 超过最大持续时间
    if (duration >= config.duration) {
      wx.showModal({
        title: '噪声警报',
        content: `噪声持续${duration.toFixed(1)}秒，建议处理环境噪声！`,
      });
      resetNoiseState();
    }
    
    // 实时上报噪声水平（示例）
    reportNoiseLevel(energy, duration);
  }
}


// 重置噪声状态
function resetNoiseState() {
  noiseState = {
    isNoisy: false,
    continuousCount: 0,
    startTime: 0,
    energyHistory: []
  };
}

// 停止监测
function stopNoiseMonitoring() {
  recorderManager.stop();
  resetNoiseState();
}

