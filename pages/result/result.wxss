page {
  background: #f5f7fa;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.page {
  padding: 40rpx;
}

.grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.container {
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.title {
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 20px;
}
.result {
  font-size: 18px;
  margin-bottom: 20px;
}
.nav-buttons {
  display: flex;
  justify-content: space-around;
  width: 100%;
}
.nav-buttons button {
  width: 45%;
}

.card {
  display: flex;
  align-items: center;
  padding: 36rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card--pressed {
  background: #4facfec2 !important;   /* 按下的瞬间变纯蓝 */
  /* 不加 transform / scale / opacity，图标文字就不会动 */
}

.card__icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.card__body {
  flex: 1;
}

.card__title {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.card__desc {
  font-size: 26rpx;
  opacity: 0.7;
  margin-top: 8rpx;
  display: block;
}

.card__arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.5;
}

.card-active {
  display: flex;
  align-items: center;
  padding: 36rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  background: #4facfe5b;
  transition: all 0.6s ease-out;
}
.card .detailed-info {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: all 0.4s ease;
}

.card-active .detailed-info {
  display: block;
  opacity: 1;
}

.card-hover::before {
  opacity: 1;
}

.card-active::before {
  opacity: 0;
}

.btn {
  margin: 20rpx 30rpx;
  padding: 20rpx;
  font-size: 30rpx;
  border-radius: 16rpx;
}
.btn--primary {
  background: linear-gradient(to right, #4facfe, #00f2fe);
  color: white;
}
.btn--ghost {
  background: transparent;
  color: #4facfe;
  border: 2rpx solid #4facfe;
}
.btn--plain {
  background: #f5f5f5;
  color: #333;
}