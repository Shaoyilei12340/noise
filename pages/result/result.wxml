<template name="listedResult">
  <view>
    <view class="card__body">
      <text class="card__title">{{date}}</text>
      <text class="card__desc">记录时长：{{duration}} (s)</text>
      <text class="card__desc">预计暴露时间：{{exposure}} (s)</text>
      <text class="card__desc">CNE值：{{cne}} (dB(A))</text>
      <text class="card__desc">预估危险水平：{{threat}}</text>
      <view class="detailed-info">
        <text class="card__desc">麦克风偏移量：{{offset}}</text>
        <text class="card__desc">设备标识：{{device}}</text>
        <text class="card__desc">操作系统：{{system}}</text>
        <text class="card__desc">版本戳：{{vstamp}}</text>
      </view>
    </view>
  </view>
</template>

<template name="listedDetailedResult">
  <view class="card" hover-class="card--pressed">
    <view class="card__body">
      <text class="card__title">{{date}}</text>
      <text class="card__desc">记录时长：{{duration}} (s)</text>
      <text class="card__desc">预计暴露时间：{{exposure}} (s)</text>
      <text class="card__desc">CNE值：{{cne}} (dB(A))</text>
      <text class="card__desc">预估危险水平：{{threat}}</text>
      <text class="card__desc">麦克风偏移量：{{offset}}</text>
      <text class="card__desc">设备标识：{{device}}</text>
      <text class="card__desc">操作系统：{{system}}</text>
      <text class="card__desc">版本戳：{{vstamp}}</text>
    </view>
  </view>
</template>

<view class="page">
  <button class="btn btn--primary" bindtap="">清空结果</button>
  <view class="grid">
    <block wx:for="{{savedResult}}" wx:key="index">
      <view 
        class="card{{activeIndex === index ? '-active' : ''}}"
        hover-class="card--pressed"
        data-index="{{index}}"
        bindtap="handleCardTap"
      >
        <template is="listedResult" data="{{...item}}"/>
      </view>
    </block>
  </view>
</view>
